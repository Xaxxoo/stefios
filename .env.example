NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://HOST:6379
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://RPC_HOST
STELLAR_HORIZON_URL=https://HORIZON_HOST
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=86400
ANCHOR_REQUEST_TIMEOUT_MS=8000
ANCHOR_STATE_TTL_SECONDS=1800
CROSS_CHAIN_PROVIDER=UNCONFIGURED_PROVIDER_ID
# Blend configuration is intentionally explicit: use only pool IDs verified for the selected network.
BLEND_MAINNET_RPC=https://RPC_HOST
BLEND_MAINNET_PASSPHRASE=STELLAR_NETWORK_PASSPHRASE
BLEND_MAINNET_POOL_IDS_JSON=[]
BLEND_TESTNET_RPC=https://RPC_HOST
BLEND_TESTNET_PASSPHRASE=STELLAR_NETWORK_PASSPHRASE
BLEND_TESTNET_POOL_IDS_JSON=[]
AQUARIUS_MAINNET_API=https://AQUARIUS_AMM_API_HOST/api/external/v1
AQUARIUS_MAINNET_RPC=https://SOROBAN_RPC_HOST
AQUARIUS_MAINNET_PASSPHRASE=STELLAR_NETWORK_PASSPHRASE
AQUARIUS_MAINNET_ROUTER=VERIFIED_AQUARIUS_ROUTER_CONTRACT
AQUARIUS_TESTNET_API=https://AQUARIUS_AMM_API_HOST/api/external/v1
AQUARIUS_TESTNET_RPC=https://SOROBAN_RPC_HOST
AQUARIUS_TESTNET_PASSPHRASE=STELLAR_NETWORK_PASSPHRASE
AQUARIUS_TESTNET_ROUTER=VERIFIED_AQUARIUS_ROUTER_CONTRACT
